# Configuration distante : utiliser des valeurs uniques et HTTPS.
# Pour le développement local, les scripts créent .runtime/database.env.
DATABASE_URL=postgresql+psycopg://shopeo:CHANGE_ME@127.0.0.1:5432/shopeo
LOCAL_DEMO=1
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
AUTO_CREATE_SCHEMA=1
SEED_DEMO=1
# Configurés automatiquement par scripts/configure-n8n.mjs :
AUTOMATION_SECRET=
N8N_WEBHOOK_URL=
# Facultatif : API compatible chat/completions, aucun appel externe par défaut.
AI_ALLOW_EXTERNAL=0
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=
# Hébergement Vercel : LOCAL_DEMO=0, COOKIE_SECURE=1,
# AUTO_CREATE_SCHEMA=0, SEED_DEMO=0. Ne jamais publier les secrets.
DATABASE_SCHEMA=
MIGRATION_DATABASE_URL=
SHOPEO_API_URL=http://127.0.0.1:8100
INTERNAL_PROXY_SECRET=
CRON_SECRET=
PAYMENTS_SIMULATED=1
